RewriteEngine On

RewriteBase /jobalerthub/

#########################################
# Disable Directory Listing
#########################################
Options -Indexes


#########################################
# Allow Admin Panel
#########################################
RewriteRule ^admin_hub(/.*)?$ - [L]


#########################################
# Allow API
#########################################
RewriteRule ^api(/.*)?$ - [L]


#########################################
# Allow Download
#########################################
RewriteRule ^download\.php$ - [L]


#########################################
# Serve Real Files Only
#########################################
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]


#########################################
# Home
#########################################
RewriteRule ^$ index.php [L]


#########################################
# Search
#########################################
RewriteRule ^search/?$ search/index.php [L,QSA]


#########################################
# Jobs
#########################################
RewriteRule ^job/?$ job/index.php [L,QSA]
RewriteRule ^job/([^/]+)/?$ job/details.php?slug=$1 [L,QSA]


#########################################
# Results
#########################################
RewriteRule ^result/?$ result/index.php [L,QSA]
RewriteRule ^result/([^/]+)/?$ result/details.php?slug=$1 [L,QSA]


#########################################
# Admit Card
#########################################
RewriteRule ^admit-card/?$ admit-card/index.php [L,QSA]
RewriteRule ^admit-card/([^/]+)/?$ admit-card/details.php?slug=$1 [L,QSA]


#########################################
# Answer Key
#########################################
RewriteRule ^answer-key/?$ answer-key/index.php [L,QSA]
RewriteRule ^answer-key/([^/]+)/?$ answer-key/details.php?slug=$1 [L,QSA]


#########################################
# Current Affairs
#########################################
RewriteRule ^current-affair/?$ current-affair/index.php [L,QSA]
RewriteRule ^current-affair/([^/]+)/?$ current-affair/details.php?slug=$1 [L,QSA]


#########################################
# Category
#########################################
RewriteRule ^category/([^/]+)/?$ category/index.php?slug=$1 [L,QSA]


#########################################
# PDF Store
#########################################
RewriteRule ^pdf/?$ pdf/index.php [L,QSA]
RewriteRule ^pdf/([^/]+)/?$ pdf/details.php?slug=$1 [L,QSA]


#########################################
# Redirect Details URLs
#########################################

RewriteCond %{THE_REQUEST} \s/+jobalerthub/job/details\.php\?slug=([^&\s]+) [NC]
RewriteRule ^job/details\.php$ /jobalerthub/job/%1? [R=301,L]


RewriteCond %{THE_REQUEST} \s/+jobalerthub/result/details\.php\?slug=([^&\s]+) [NC]
RewriteRule ^result/details\.php$ /jobalerthub/result/%1? [R=301,L]


RewriteCond %{THE_REQUEST} \s/+jobalerthub/admit-card/details\.php\?slug=([^&\s]+) [NC]
RewriteRule ^admit-card/details\.php$ /jobalerthub/admit-card/%1? [R=301,L]


RewriteCond %{THE_REQUEST} \s/+jobalerthub/pdf/details\.php\?slug=([^&\s]+) [NC]
RewriteRule ^pdf/details\.php$ /jobalerthub/pdf/%1? [R=301,L]


#########################################
# Custom 404
#########################################
ErrorDocument 404 /jobalerthub/404.php
# Contact
RewriteRule ^contact/?$ contact/index.php [L,QSA]
RewriteRule ^about/?$ about/index.php [L,QSA]
# privacy , term& condition and disclaimer
RewriteRule ^privacy-policy/?$ privacy-policy/index.php [L,QSA]

RewriteRule ^terms-condition/?$ terms-condition/index.php [L,QSA]

RewriteRule ^disclaimer/?$ disclaimer/index.php [L,QSA]
RewriteRule ^refund-policy/?$ refund-policy/index.php [L,QSA]

#site map
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ===============================
# Browser Cache Settings
# ===============================

<IfModule mod_expires.c>

ExpiresActive On

# Images
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"

# CSS
ExpiresByType text/css "access plus 1 month"

# JavaScript
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"

# Fonts
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"

# HTML
ExpiresByType text/html "access plus 1 hour"

</IfModule>


# ===============================
# Cache-Control Headers
# ===============================

<IfModule mod_headers.c>

<FilesMatch "\.(webp|png|jpg|jpeg|svg|woff|woff2|css|js)$">

Header set Cache-Control "public, max-age=31536000"

</FilesMatch>


<FilesMatch "\.(html|php)$">

Header set Cache-Control "no-cache, no-store, must-revalidate"

</FilesMatch>


</IfModule>